# Export these settings in the environment before launching server.py.
# The one public URL of this site. Local: http://127.0.0.1:4188 (open exactly this host, not localhost).
# Production: https://printbee.co.in. Cookies, CSRF checks, Google redirect URI (<origin>/api/auth/google/callback)
# and email links all derive from it. See docs/connected-workflow/CONNECTED-PORTALS.md.
PRINTBEE_ORIGIN=http://127.0.0.1:4188
# Local development only: where the database lives (default: %LOCALAPPDATA%/PrintBeeLocal) and sample-data screens.
PRINTBEE_DATA_DIR=
PRINTBEE_ALLOW_PREVIEW=
# Local demo identities (python demo.py sets this; refused with a real origin or real payments).
PRINTBEE_DEMO=
PRINTBEE_GOOGLE_CLIENT_ID=
PRINTBEE_GOOGLE_CLIENT_SECRET=
PRINTBEE_GOOGLE_WAREHOUSE_EMAILS=
PRINTBEE_GOOGLE_ADMIN_EMAILS=
PRINTBEE_GOOGLE_PARTNERS={}
PRINTBEE_PAYMENT_MODE=disabled
PRINTBEE_RAZORPAY_KEY_ID=
PRINTBEE_RAZORPAY_KEY_SECRET=
PRINTBEE_RAZORPAY_WEBHOOK_SECRET=
PRINTBEE_CHECKOUT_TERMS={"packing":0,"platform":0,"delivery":0,"taxBasisPoints":0,"slots":[],"coupons":{},"paperRates":{},"bindingRates":{}}
PRINTBEE_SOFFICE=
PRINTBEE_S3_BUCKET=
PRINTBEE_S3_ENDPOINT=
PRINTBEE_MAPS_BROWSER_KEY=
PRINTBEE_MAPS_MAP_ID=
PRINTBEE_PARTNER_KEYS={}
PRINTBEE_PARTNER_PHONES={}
PRINTBEE_TWILIO_VERIFY_SERVICE=
PRINTBEE_TWILIO_ACCOUNT=
PRINTBEE_TWILIO_TOKEN=
# Optional: the owner is emailed about urgent, escalated and unanswered support tickets
PRINTBEE_OWNER_EMAIL=
