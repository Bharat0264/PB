# Export these settings in the environment before launching server.py.
# The one public URL of this site. Local: http://127.0.0.1:4188 (open exactly this host, not localhost).
# Production: https://printbee.co.in. Cookies, CSRF checks, Google redirect URI (<origin>/api/auth/google/callback)
# and email links all derive from it. See docs/connected-workflow/CONNECTED-PORTALS.md.
PRINTBEE_ORIGIN=http://127.0.0.1:4188
# Local development only: where the database lives (default: %LOCALAPPDATA%/PrintBeeLocal) and sample-data screens.
PRINTBEE_DATA_DIR=
PRINTBEE_ALLOW_PREVIEW=
# Local demo identities (python demo.py sets this; refused with a real origin or real payments).
PRINTBEE_DEMO=
PRINTBEE_GOOGLE_CLIENT_ID=
PRINTBEE_GOOGLE_CLIENT_SECRET=
PRINTBEE_GOOGLE_WAREHOUSE_EMAILS=
PRINTBEE_GOOGLE_ADMIN_EMAILS=
PRINTBEE_GOOGLE_PARTNERS={}
PRINTBEE_PAYMENT_MODE=disabled
PRINTBEE_RAZORPAY_KEY_ID=
PRINTBEE_RAZORPAY_KEY_SECRET=
PRINTBEE_RAZORPAY_WEBHOOK_SECRET=
PRINTBEE_CHECKOUT_TERMS={"packing":0,"platform":0,"delivery":0,"taxBasisPoints":0,"slots":[],"coupons":{},"paperRates":{},"bindingRates":{}}
PRINTBEE_SOFFICE=
PRINTBEE_S3_BUCKET=
PRINTBEE_S3_ENDPOINT=
PRINTBEE_MAPS_BROWSER_KEY=
PRINTBEE_MAPS_MAP_ID=
PRINTBEE_PARTNER_KEYS={}
PRINTBEE_PARTNER_PHONES={}
PRINTBEE_TWILIO_VERIFY_SERVICE=
PRINTBEE_TWILIO_ACCOUNT=
PRINTBEE_TWILIO_TOKEN=
# Optional: the owner is emailed about urgent, escalated and unanswered support tickets
PRINTBEE_OWNER_EMAIL=
# Buzz, the support chatbot. Which provider answers: mock (canned answers, no model, the default) or gemini.
# Gemini without its key, or any other value, falls back to mock with a warning in the log. Never commit a real key.
PRINTBEE_SUPPORT_PROVIDER=mock
# Gemini (read only on the server; the free tier may use what it is sent, so Buzz sends no personal data).
# Check the model names available to your key in Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=
PRINTBEE_GEMINI_MODEL=gemini-3.5-flash-lite
# Stop calling the model for the day after this many US dollars (Buzz then offers to create a ticket instead).
PRINTBEE_CHAT_DAILY_CAP_USD=5
# Chats are deleted after this many days.
PRINTBEE_CHAT_RETENTION_DAYS=30
# Set to 1 to force mock mode whatever the provider setting says.
PRINTBEE_BUZZ_MOCK=

# Email (sign-in links, order and support updates). Without these, email sign-in answers "temporarily unavailable".
PRINTBEE_SMTP_HOST=
PRINTBEE_SMTP_PORT=587
PRINTBEE_SMTP_FROM=
PRINTBEE_SMTP_USER=
PRINTBEE_SMTP_PASSWORD=
# Days of inactivity before a customer is signed out (default 7).
PRINTBEE_SESSION_DAYS=7
# Staff API keys (the X-Staff-Key header) are OFF unless this is 1. Staff normally sign in with Google.
PRINTBEE_ALLOW_STAFF_KEYS=
# Seconds a silent connection may stay open before it is dropped (default 30).
PRINTBEE_CONNECTION_TIMEOUT=30
# Unpaid orders (and their files) are removed after this many hours (default 24).
PRINTBEE_UNPAID_ORDER_HOURS=24
# Set to 1 only if EVERY subdomain of your domain is https: adds includeSubDomains to the HSTS header.
PRINTBEE_HSTS_SUBDOMAINS=
# Opt-in sample orders for a tester's Orders page (finished / in progress), keyed by that tester's email.
PRINTBEE_SAMPLE_ORDER_EMAIL=
PRINTBEE_SAMPLE_ACTIVE_ORDER_EMAIL=
