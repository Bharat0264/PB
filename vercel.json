{
  "redirects": [
    {"source": "/", "destination": "/welcome.html", "permanent": false}
  ],
  "rewrites": [
    {"source": "/admin", "destination": "/admin.html"},
    {"source": "/partner", "destination": "/partner.html"},
    {"source": "/warehouse", "destination": "/staff.html"},
    {"source": "/home", "destination": "/navigation.html"},
    {"source": "/orders", "destination": "/navigation.html"},
    {"source": "/upload", "destination": "/navigation.html"},
    {"source": "/address", "destination": "/navigation.html"},
    {"source": "/profile", "destination": "/navigation.html"}
  ],
  "functions": {
    "api/[...path].js": {"maxDuration": 60}
  }
}
